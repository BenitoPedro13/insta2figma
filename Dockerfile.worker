# Worker BullMQ — Railway
# Local: docker build -f Dockerfile.worker -t insta2figma-worker .

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
ENV NODE_ENV=development
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY packages/shared-contracts/package.json packages/shared-contracts/
COPY packages/shared-config/package.json packages/shared-config/
COPY packages/shared-instagram/package.json packages/shared-instagram/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY packages/shared-config packages/shared-config
COPY packages/shared-contracts packages/shared-contracts
COPY packages/shared-instagram packages/shared-instagram
COPY apps/api apps/api
COPY apps/worker apps/worker
COPY turbo.json turbo.json
RUN pnpm --filter @insta2figma/shared-contracts build \
  && pnpm --filter @insta2figma/shared-instagram build \
  && pnpm --filter @insta2figma/api build \
  && pnpm --filter @insta2figma/worker build

FROM base
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/apps/worker
ENTRYPOINT ["node", "dist/main.js"]
