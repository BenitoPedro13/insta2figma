# Framer plugin has no build-time env vars.
# All runtime config lives in FramerHost.ts (API URL hardcoded to Railway production).
#
# ── Local development ────────────────────────────────────────────────────────
# The Framer dev server runs at https://localhost:5173.
# To point the plugin at a local API instead of Railway, update the API constant
# in apps/framer-plugin/src/FramerHost.ts and add this to apps/api/.env:
#
#   CORS_ORIGINS=https://localhost:5173
#
# ── Microsoft Clarity (optional analytics) ──────────────────────────────────
# VITE_CLARITY_PROJECT_ID=
