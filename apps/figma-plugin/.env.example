# ── Analytics (optional) ─────────────────────────────────────────────────────
# Microsoft Clarity project ID. Create a project at https://clarity.microsoft.com/
# Settings → Setup → copy the Project ID.
VITE_CLARITY_PROJECT_ID=

# ── API target (build-time, optional) ────────────────────────────────────────
# Controls which API the plugin talks to. Defaults to "auto" (probes localhost:3333
# first; falls back to Railway). Set at build time via the environment:
#
#   INSTA2FIGMA_API_MODE=auto        # default: probe local, fall back to prod
#   INSTA2FIGMA_API_MODE=local       # always use localhost:3333
#   INSTA2FIGMA_API_MODE=production  # always use Railway
#
# Override the URLs (rarely needed):
#   INSTA2FIGMA_LOCAL_API_BASE=http://localhost:3333
#   INSTA2FIGMA_PRODUCTION_API_BASE=https://insta2figma-production.up.railway.app
