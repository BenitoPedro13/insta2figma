{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["ui-src/**/*.ts", "ui-src/**/*.tsx", "vite.config.ts"]
}
