{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "typeRoots": ["./node_modules/@types"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["ui-src/*"]
    }
  },
  "include": ["ui-src/**/*.ts", "ui-src/**/*.tsx", "vite.config.ts"]
}
