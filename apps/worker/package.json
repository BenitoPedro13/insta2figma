{
  "name": "@insta2figma/worker",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "prisma generate --schema ../api/prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "prisma generate --schema ../api/prisma/schema.prisma && tsx watch src/main.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "RUN_IG_INTEGRATION=1 vitest run src/instagram/http-instagram.integration.test.ts",
    "ig:smoke": "tsx scripts/instagram-scrape-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@insta2figma/shared-contracts": "workspace:*",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.1.4"
  }
}
