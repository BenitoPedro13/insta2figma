# Replica `apps/api/.env`: mesma BD e Redis.
DATABASE_URL="postgresql://insta2figma:insta2figma@localhost:5432/insta2figma?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
WORKER_CONCURRENCY=2
# Timeout HTTP para web_profile_info (ms)
IG_FETCH_TIMEOUT_MS=30000

# --- Sessões Instagram (ver ADR-002, ADR-003) ---
# Pool de sessões com proxy dedicado por conta
# Formato: [{"account":"bot1","cookie":"sessionid=...","proxy":"http://user:pass@host:port"}]
IG_SESSION_POOL=
# Pool de proxies rotativos para requests sem sessão
# IG_PROXY_POOL=["http://user:pass@p.webshare.io:80","http://user2:pass2@p.webshare.io:80"]
IG_PROXY_POOL=
# Proxy único de fallback (depreciado; usar IG_PROXY_POOL)
HTTP_PROXY_URL=

# --- Fallback Apify (profile-preview quando Instagram rate-limita) ---
# Sem token => fallback desativado
APIFY_TOKEN=
APIFY_IG_PROFILE_ACTOR=apify~instagram-profile-scraper
APIFY_TIMEOUT_MS=120000

# --- Object storage (copiar os mesmos valores S3_* que na API) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=insta2figma
S3_ACCESS_KEY=insta2figma
S3_SECRET_KEY=insta2figma_dev
S3_FORCE_PATH_STYLE=true
# Nota: PUBLIC_S3_ENDPOINT só é necessário na API (presign para o browser)
STORAGE_MAX_THUMBNAILS=12
ASSET_FETCH_TIMEOUT_MS=20000
