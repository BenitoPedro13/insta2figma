DATABASE_URL="postgresql://insta2figma:insta2figma@localhost:5432/insta2figma?schema=public"
PORT=3333
JWT_SECRET="alterar-em-desenvolvimento-use-string-longa-min-32-char"
JWT_EXPIRES_IN=30d
# URL pública da API — usada nos links de magic link enviados por email
PUBLIC_API_URL=http://localhost:3333
# --- Auth Google (magic link via Gmail API + Google OAuth login) ---
# Setup completo: docs/AUTH.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/v1/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GMAIL_FROM=
# Destino dos emails de "Send feedback" (default: GMAIL_FROM)
FEEDBACK_EMAIL_TO=
REDIS_URL="redis://127.0.0.1:6379"
# Origens CORS extra (separadas por vírgulas). Sempre se somam a `null` + domínios Figma (plugin).
CORS_ORIGINS=
# --- Object storage (MinIO / S3-compat) — Fase 6 ---
S3_ENDPOINT=http://127.0.0.1:9000
PUBLIC_S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=insta2figma
S3_ACCESS_KEY=insta2figma
S3_SECRET_KEY=insta2figma_dev
S3_FORCE_PATH_STYLE=true
ASSET_PRESIGN_SECONDS=3600
# --- Polar billing (Fase 7) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_ID_PRO_MONTHLY=
POLAR_PRODUCT_ID_PRO_YEARLY=
POLAR_PRODUCT_ID_MAX_MONTHLY=
POLAR_PRODUCT_ID_MAX_YEARLY=
# Domínio para emails sintéticos Figma (Polar exige DNS real; não uses example.com)
POLAR_SYNTHETIC_EMAIL_DOMAIN=mailinator.com
# Em produção: https://<api-domain>.up.railway.app/v1/billing/checkout-success
# Para testar localmente: usar ngrok + http://localhost:3333/v1/billing/checkout-success
POLAR_SUCCESS_URL=
POLAR_RETURN_URL=https://mainnet.design/
# --- Quotas ---
QUOTA_FREE_IMAGES_PER_MONTH=100
QUOTA_PRO_IMAGES_PER_MONTH=10000
QUOTA_MAX_IMAGES_PER_MONTH=100000
QUOTA_MAX_POSTS_PER_JOB=50
QUOTA_MAX_IMAGES_PER_JOB=100

# --- Scraper Instagram ---
# Pool de sessões com proxy dedicado por conta (ver ADR-002, ADR-003)
# Cria contas com o browser a correr pelo proxy para evitar checkpoint_required
# Formato: [{"account":"bot1","cookie":"sessionid=...","proxy":"http://user:pass@host:port"}]
IG_SESSION_POOL=
# Pool de proxies rotativos (Webshare ou similar) para requests sem sessão
# IG_PROXY_POOL=["http://user:pass@p.webshare.io:80","http://user2:pass2@p.webshare.io:80"]
IG_PROXY_POOL=
# Proxy único de fallback (depreciado; usar IG_PROXY_POOL)
HTTP_PROXY_URL=

# --- Fallback Apify (profile-preview quando Instagram rate-limita) ---
# Sem token => preview continua só via Instagram direct
APIFY_TOKEN=
# Actor para o carregamento inicial (página 1) — devolve metadados do perfil + primeiros 12 posts
APIFY_IG_PROFILE_ACTOR=apify~instagram-profile-scraper
# Actor para paginação (página 2+) e imports — suporta 50+ posts via directUrls
# Se omitido, usa APIFY_IG_PROFILE_ACTOR como fallback
APIFY_IG_POST_ACTOR=apify~instagram-scraper
APIFY_TIMEOUT_MS=120000

# --- Catálogo persistente + dedup de media (TASK-persistent-ig-catalog-dedup) ---
# Write-through do catálogo (IgProfile/IgPost) em cada preview. Seguro (só escreve).
CATALOG_WRITE_THROUGH=true
# Leitura catalog-first (serve do Postgres/S3; top-check incremental ao IG). Default OFF.
CATALOG_ENABLED=false
# Janela sem top-check ao IG quando o catálogo está quente (ms).
CATALOG_REFRESH_TTL_MS=300000
# Enfileira o backfill assíncrono de covers. Ligar SÓ depois do worker de backfill correr.
CATALOG_BACKFILL_ENABLED=false
# Worker de backfill (apps/worker) — fila media-backfill-v1.
MEDIA_BACKFILL_CONCURRENCY=4
MEDIA_BACKFILL_ATTEMPTS=3
