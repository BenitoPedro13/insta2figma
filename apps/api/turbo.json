{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", "node_modules/.prisma/**"],
      "cache": false
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": false,
      "env": ["DATABASE_URL", "JWT_SECRET"]
    }
  }
}
