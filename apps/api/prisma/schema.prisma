generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String?  @unique
  googleId        String?  @unique @map("google_id")
  emailVerified   Boolean  @default(false) @map("email_verified")
  figmaUserId     String?  @unique @map("figma_user_id")
  framerUserId    String?  @unique @map("framer_user_id")
  polarCustomerId String?  @map("polar_customer_id")
  planTier        String   @default("free") @map("plan_tier")
  quotaAnchorAt   DateTime? @map("quota_anchor_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobs          Job[]
  subscriptions Subscription[]
  usageCounters UsageCounter[]
  authTokens    AuthToken[]
  feedbacks     Feedback[]

  @@map("users")
}

model AuthToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  pollingId String   @unique @map("polling_id")
  userId    String?  @map("user_id") @db.Uuid
  email     String?  // email do utilizador (magic link)
  type      String   // 'magic_link' | 'google_oauth'
  jwt       String?  @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pollingId])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  polarSubscriptionId  String    @unique @map("polar_subscription_id")
  productId            String    @map("product_id")
  status               String
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model UsageCounter {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  periodStart DateTime @map("period_start") @db.Date
  imagesUsed  Int      @default(0) @map("images_used")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@map("usage_counters")
}

model WebhookEvent {
  id           String   @id @default(uuid()) @db.Uuid
  polarEventId String   @unique @map("polar_event_id")
  eventType    String   @map("event_type")
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("webhook_events")
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  canceled

  @@map("job_status")
}

model Job {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  type                String
  /// Plataforma de origem: "figma" | "framer" (null em jobs antigos)
  platform            String?
  input               Json
  status              JobStatus @default(queued)
  resultSummary       Json?     @map("result_summary")
  resultStoragePrefix String?   @map("result_storage_prefix")
  errorCode           String?   @map("error_code")
  errorMessage        String?   @map("error_message") @db.Text
  idempotencyKey      String?   @map("idempotency_key")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt           DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt          DateTime? @map("finished_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("jobs")
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  message   String   @db.Text
  /// Plataforma de origem: "figma" | "framer" (injectada pelo host, invisível ao utilizador)
  platform  String?
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("feedback")
}

model ScrapeTelemetry {
  id             String   @id @default(uuid()) @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  endpoint       String
  igUsername     String   @map("ig_username")
  sessionAccount String?  @map("session_account")
  proxyUsed      Boolean  @default(false) @map("proxy_used")
  cacheHit       Boolean  @default(false) @map("cache_hit")
  statusCode     Int      @map("status_code")
  retryCount     Int      @default(0) @map("retry_count")
  latencyMs      Int      @map("latency_ms")
  errorKind      String?  @map("error_kind")
  userId         String?  @map("user_id") @db.Uuid
  planTier       String?  @map("plan_tier")

  @@index([createdAt(sort: Desc)])
  @@index([igUsername, createdAt(sort: Desc)])
  @@index([sessionAccount, createdAt(sort: Desc)])
  @@index([errorKind, createdAt(sort: Desc)])
  @@map("scrape_telemetry")
}

model Asset {
  id          String    @id @default(uuid()) @db.Uuid
  jobId       String    @map("job_id") @db.Uuid
  contentType String    @map("content_type")
  storageKey  String    @map("storage_key")
  byteSize    BigInt    @map("byte_size")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("assets")
}
