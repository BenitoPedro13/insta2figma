{
  "name": "insta2figma",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "bootstrap": "node scripts/setup.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:logs:postgres": "docker compose logs -f postgres",
    "infra:logs:redis": "docker compose logs -f redis",
    "docker:build:api": "docker build -f Dockerfile.api -t insta2figma-api .",
    "docker:build:worker": "docker build -f Dockerfile.worker -t insta2figma-worker .",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.prod down",
    "dev": "concurrently --kill-others-on-fail -n api,worker -c cyan,magenta \"pnpm run dev:api\" \"pnpm run dev:worker\"",
    "db:migrate:dev": "pnpm --filter @insta2figma/api exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @insta2figma/api exec prisma migrate deploy",
    "db:smoke": "pnpm --filter @insta2figma/api run db:smoke",
    "dev:api": "pnpm --filter @insta2figma/api run start:dev",
    "dev:worker": "pnpm --filter @insta2figma/worker run start:dev",
    "ig:smoke": "pnpm --filter @insta2figma/worker run ig:smoke",
    "test:ig": "pnpm --filter @insta2figma/worker run test:integration"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "turbo": "^2.3.3"
  }
}
